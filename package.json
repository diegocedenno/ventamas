{
  "name": "ventamas",
  "productName": "Ventamas",
  "version": "0.2.0",
  "description": "Punto de venta, inventario y clientes para comercios pequeños. Funciona sin internet y cobra en varias monedas.",
  "author": "Diego Cedeño",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/diegocedenno/ventamas",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "icon": "node scripts/build-icon.mjs",
    "lock-migrations": "node scripts/lock-migrations.mjs",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.51.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
